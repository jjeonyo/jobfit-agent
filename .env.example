# OpenAI API 키 (필수 — 없으면 분석 대신 503을 반환한다)
OPENAI_API_KEY=
# Supabase pgvector (선택 — 비워두면 키워드 검색만 쓴다)
# db/supabase.sql을 먼저 실행하고, SUPABASE_KEY에는 service_role 키를 넣는다 (서버 전용).
SUPABASE_URL=
SUPABASE_KEY=
# 분석 기록 (선택 — 비워두면 기록하지 않는다). docs/n8n-기록.md 참조.
# Compose의 record 프로필로 n8n을 띄우면 아래 주소를 쓴다. 토큰은 n8n Webhook 노드의
# Header Auth(X-JobFit-Token) 값과 같아야 한다.
RECORD_WEBHOOK_URL=
RECORD_WEBHOOK_TOKEN=
